# Copy this file to .streamlit/secrets.toml (which is git-ignored) and fill in
# your key. This is entirely optional.
#
# CARTO_BASEMAP_API_KEY only affects the "Define area" drawing map: with a key,
# it uses CARTO Voyager raster tiles; without one, it falls back to
# OpenStreetMap tiles. The rest of the app, including the main result map, does
# not use this key.
#
# The key can also be supplied as an environment variable of the same name.

CARTO_BASEMAP_API_KEY = "your-key-here"
